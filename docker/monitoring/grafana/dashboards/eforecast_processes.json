{
  "title": "eforecast processes",
  "description": "Every process of the pipeline and what it uses, the heaviest other processes, the machine, the cards and the containers. From the metrics service (port 9109, /processes), which tells a process by its command line.",
  "uid": "eforecast-processes",
  "schemaVersion": 39,
  "tags": ["eforecast"],
  "refresh": "15s",
  "timepicker": {"refresh_intervals": ["5s", "10s", "15s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]},
  "time": {"from": "now-6h", "to": "now"},
  "links": [{"type": "dashboards", "title": "eforecast", "tags": ["eforecast"], "asDropdown": true, "icon": "dashboard"}, {"type": "link", "title": "Optuna dashboard", "url": "http://localhost:8080", "targetBlank": true, "icon": "external link", "tooltip": "every study and trial, with its curves and parameters"}],
  "templating": {"list": []},
  "panels": [
    {"type": "row", "title": "The machine", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "collapsed": false},
    {"type": "timeseries", "title": "Processors, by what they do", "gridPos": {"x": 0, "y": 1, "w": 8, "h": 8}, "description": "Processors working for programs (user), for the system, and waiting for storage. The dashed line is how many the machine has: the distance to it is what is idle.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (mode) (rate(eforecast_machine_cpu_seconds_total{mode!=\"idle\"}[1m]))", "legendFormat": "{{mode}}"}, {"refId": "B", "expr": "max(eforecast_machine_cpus)", "legendFormat": "the machine has"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 1, "fillOpacity": 30, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "normal"}}, "decimals": 1}, "overrides": [{"matcher": {"id": "byName", "options": "the machine has"}, "properties": [{"id": "custom.stacking", "value": {"mode": "none"}}, {"id": "custom.fillOpacity", "value": 0}, {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [6, 4]}}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "text"}}]}]}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Load", "gridPos": {"x": 8, "y": 1, "w": 8, "h": 8}, "description": "Processes running or waiting to run. Above the number of processors, something is waiting.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (window) (eforecast_machine_load)", "legendFormat": "over {{window}}"}, {"refId": "B", "expr": "max(eforecast_machine_cpus)", "legendFormat": "processors"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}, "min": 0, "decimals": 1}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Memory", "gridPos": {"x": 16, "y": 1, "w": 8, "h": 8}, "description": "Memory in use by programs, against what the machine has. Swap in use means memory ran short.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(eforecast_machine_memory_bytes{kind=\"used\"})", "legendFormat": "used"}, {"refId": "B", "expr": "max(eforecast_machine_memory_bytes{kind=\"total\"})", "legendFormat": "the machine has"}, {"refId": "C", "expr": "max(eforecast_machine_memory_bytes{kind=\"swap used\"})", "legendFormat": "swap used"}], "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "row", "title": "The pipeline's processes", "gridPos": {"x": 0, "y": 9, "w": 24, "h": 1}, "collapsed": false},
    {"type": "timeseries", "title": "Processors in use, by kind of process", "gridPos": {"x": 0, "y": 10, "w": 12, "h": 9}, "description": "A training, its trials, their data loaders, a combination's workers, the services.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (role) (rate(eforecast_process_cpu_seconds_total{role!=\"other\"}[1m]))", "legendFormat": "{{role}}"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 1, "fillOpacity": 30, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "normal"}}, "decimals": 2}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Memory, by kind of process", "gridPos": {"x": 12, "y": 10, "w": 12, "h": 9}, "description": "Resident memory, added up over the processes of each kind.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (role) (eforecast_process_memory_bytes{role!=\"other\"})", "legendFormat": "{{role}}"}], "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 1, "fillOpacity": 30, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "normal"}}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Processors in use, trial by trial", "gridPos": {"x": 0, "y": 19, "w": 12, "h": 9}, "description": "Each trial with its data loaders.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (case, cluster, method, trial) (rate(eforecast_process_cpu_seconds_total{role=~\"trial|data loader\"}[1m]))", "legendFormat": "{{case}} {{cluster}} {{method}} {{trial}}"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}, "decimals": 2}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Reading and writing, by kind of process", "gridPos": {"x": 12, "y": 19, "w": 12, "h": 9}, "description": "Bytes per second read from storage (up) and written to it (down). A trial that reads all the time is being fed from the disk, not from memory.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (role) (rate(eforecast_process_read_bytes_total[1m]))", "legendFormat": "{{role}} reads"}, {"refId": "B", "expr": "- sum by (role) (rate(eforecast_process_write_bytes_total[1m]))", "legendFormat": "{{role}} writes"}], "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "table", "title": "Every process now", "gridPos": {"x": 0, "y": 28, "w": 24, "h": 11}, "description": "The pipeline's processes, each told by its command line, and as role other the heaviest other processes of the machine. The same as bin/eforecast status.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (role, case, cluster, method, trial, name, pid) (rate(eforecast_process_cpu_seconds_total[1m]))", "format": "table", "instant": true}, {"refId": "B", "expr": "max by (role, case, cluster, method, trial, name, pid) (eforecast_process_memory_bytes)", "format": "table", "instant": true}, {"refId": "C", "expr": "max by (role, case, cluster, method, trial, name, pid) (eforecast_process_gpu_memory_bytes)", "format": "table", "instant": true}, {"refId": "D", "expr": "max by (role, case, cluster, method, trial, name, pid) (eforecast_process_threads)", "format": "table", "instant": true}, {"refId": "E", "expr": "max by (role, case, cluster, method, trial, name, pid) (rate(eforecast_process_read_bytes_total[1m]))", "format": "table", "instant": true}, {"refId": "F", "expr": "max by (role, case, cluster, method, trial, name, pid) (rate(eforecast_process_write_bytes_total[1m]))", "format": "table", "instant": true}, {"refId": "G", "expr": "max by (role, case, cluster, method, trial, name, pid) (eforecast_process_start_time_seconds) * 1000", "format": "table", "instant": true}], "transformations": [{"id": "merge", "options": {}}, {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"Value #A": "CPUs", "Value #B": "memory", "Value #C": "on card", "Value #D": "threads", "Value #E": "reads", "Value #F": "writes", "Value #G": "started", "name": "what"}, "indexByName": {"role": 0, "case": 1, "cluster": 2, "method": 3, "trial": 4, "name": 5, "pid": 6, "Value #A": 7, "Value #B": 8, "Value #C": 9, "Value #D": 10, "Value #E": 11, "Value #F": 12, "Value #G": 13}}}], "fieldConfig": {"defaults": {"custom": {"align": "auto", "filterable": true, "minWidth": 50, "cellOptions": {"type": "auto"}}}, "overrides": [{"matcher": {"id": "byName", "options": "CPUs"}, "properties": [{"id": "decimals", "value": 2}]}, {"matcher": {"id": "byName", "options": "memory"}, "properties": [{"id": "unit", "value": "bytes"}, {"id": "decimals", "value": 1}]}, {"matcher": {"id": "byName", "options": "on card"}, "properties": [{"id": "unit", "value": "bytes"}, {"id": "decimals", "value": 1}]}, {"matcher": {"id": "byName", "options": "reads"}, "properties": [{"id": "unit", "value": "Bps"}, {"id": "decimals", "value": 0}]}, {"matcher": {"id": "byName", "options": "writes"}, "properties": [{"id": "unit", "value": "Bps"}, {"id": "decimals", "value": 0}]}, {"matcher": {"id": "byName", "options": "started"}, "properties": [{"id": "unit", "value": "dateTimeFromNow"}]}, {"matcher": {"id": "byName", "options": "threads"}, "properties": [{"id": "decimals", "value": 0}]}]}, "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}, "sortBy": [{"displayName": "CPUs", "desc": true}]}},
    {"type": "row", "title": "The cards", "gridPos": {"x": 0, "y": 39, "w": 24, "h": 1}, "collapsed": false},
    {"type": "timeseries", "title": "Load", "gridPos": {"x": 0, "y": 40, "w": 6, "h": 8}, "description": "How busy each card is.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (gpu) (DCGM_FI_DEV_GPU_UTIL)", "legendFormat": "card {{gpu}}"}], "fieldConfig": {"defaults": {"unit": "percent", "custom": {"lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}, "min": 0, "max": 100}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Memory, process by process", "gridPos": {"x": 6, "y": 40, "w": 6, "h": 8}, "description": "What each process holds on the cards, and each card's memory in use.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (role, case, cluster, method, trial, name) (eforecast_process_gpu_memory_bytes)", "legendFormat": "{{role}} {{cluster}} {{method}} {{trial}} {{name}}"}, {"refId": "B", "expr": "max by (gpu) (DCGM_FI_DEV_FB_USED * 1048576)", "legendFormat": "card {{gpu}} in all"}], "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Temperature and power", "gridPos": {"x": 12, "y": 40, "w": 6, "h": 8}, "description": "Each card's core temperature and the power it draws.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (gpu) (DCGM_FI_DEV_GPU_TEMP)", "legendFormat": "card {{gpu}} °C"}, {"refId": "B", "expr": "max by (gpu) (DCGM_FI_DEV_POWER_USAGE)", "legendFormat": "card {{gpu}} W"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Slowing down for heat", "gridPos": {"x": 18, "y": 40, "w": 6, "h": 8}, "description": "Share of the time each card slowed itself down for heat. Anything above zero under ordinary temperatures means a part of the card other than its core runs hot.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "100 * max by (gpu) (rate(eforecast_gpu_thermal_slowdown_seconds_total[2m]))", "legendFormat": "card {{gpu}}"}], "fieldConfig": {"defaults": {"unit": "percent", "custom": {"lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}, "min": 0, "max": 100}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "row", "title": "The containers", "gridPos": {"x": 0, "y": 48, "w": 24, "h": 1}, "collapsed": false},
    {"type": "timeseries", "title": "Processors per container", "gridPos": {"x": 0, "y": 49, "w": 12, "h": 8}, "description": "The database, Prometheus, Grafana, the Optuna dashboard and its copier, the exporters. More on eforecast containers.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[2m]))", "legendFormat": "{{name}}"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}, "decimals": 2}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Memory per container", "gridPos": {"x": 12, "y": 49, "w": 12, "h": 8}, "description": "What each container holds.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (name) (container_memory_working_set_bytes{name!=\"\"})", "legendFormat": "{{name}}"}], "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}}
  ]
