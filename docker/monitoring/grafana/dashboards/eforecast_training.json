{
  "title": "eforecast training",
  "description": "What is training now, where each trial is inside its epoch, what every study has done and has left, and what the machine is doing. Read from the processes and from the studies themselves by the metrics service (port 9109: /trials, /processes, /studies), so it shows any training, whatever started it and whatever version of the code it runs. The same in a terminal: bin/eforecast status.",
  "uid": "eforecast-training",
  "schemaVersion": 39,
  "tags": ["eforecast"],
  "refresh": "15s",
  "timepicker": {"refresh_intervals": ["5s", "10s", "15s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]},
  "time": {"from": "now-6h", "to": "now"},
  "links": [{"type": "dashboards", "title": "eforecast", "tags": ["eforecast"], "asDropdown": true, "icon": "dashboard"}, {"type": "link", "title": "Optuna dashboard", "url": "http://localhost:8080", "targetBlank": true, "icon": "external link", "tooltip": "every study and trial, with its curves and parameters"}],
  "templating": {"list": [{"name": "case", "label": "case", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(eforecast_study_trials, case)", "refId": "variable"}, "definition": "label_values(eforecast_study_trials, case)", "refresh": 2, "sort": 1, "multi": true, "includeAll": true, "allValue": ".*", "current": {"selected": true, "text": "All", "value": "$__all"}}]},
  "panels": [
    {"type": "row", "title": "Now", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "collapsed": false},
    {"type": "stat", "title": "Trials running", "gridPos": {"x": 0, "y": 1, "w": 3, "h": 4}, "description": "Trial processes training on this machine at this moment.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "count(eforecast_trial_running_seconds{case=~\"$case\"}) or vector(0)"}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}, {"color": "blue", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value", "orientation": "auto"}},
    {"type": "stat", "title": "Trials left", "gridPos": {"x": 3, "y": 1, "w": 3, "h": 4}, "description": "Trials the studies will still be given: the ones running, and the ones still to be asked for as far as each study's attempts last. A study is asked for at most twice the trials wanted of it; a trial that was stopped with its run, or whose card was lost, is not one of those attempts. What a study lacks beyond that is 'will not run' below.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(eforecast_study_trials_left{case=~\"$case\"}) or vector(0)"}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value", "orientation": "auto"}},
    {"type": "stat", "title": "Trials finished", "gridPos": {"x": 6, "y": 1, "w": 3, "h": 4}, "description": "Complete and pruned trials of every study.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(eforecast_study_trials{case=~\"$case\",state=~\"complete|pruned\"}) or vector(0)"}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value", "orientation": "auto"}},
    {"type": "stat", "title": "Trials failed", "gridPos": {"x": 9, "y": 1, "w": 3, "h": 4}, "description": "Trials that ended with an error, ran out of card memory, or were stopped with their run or their card. They cost little time but each one is a turn of the search that produced nothing.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(eforecast_study_trials{case=~\"$case\",state=\"failed\"}) or vector(0)"}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value", "orientation": "auto"}},
    {"type": "stat", "title": "Studies open", "gridPos": {"x": 12, "y": 1, "w": 3, "h": 4}, "description": "Studies (a method in a cluster of a case) that will still be given trials.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "count(eforecast_study_trials_left{case=~\"$case\"} > 0) or vector(0)"}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value", "orientation": "auto"}},
    {"type": "stat", "title": "Training left", "gridPos": {"x": 15, "y": 1, "w": 3, "h": 4}, "description": "The trials left, each taking what a finished trial of its study took on average, one after another. With two trials at a time it is half of this. A study with no finished trial yet is not counted.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(eforecast_study_trials_left{case=~\"$case\"} * on (case, cluster, method) eforecast_study_trial_seconds{case=~\"$case\"}) or vector(0)"}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 1, "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value", "orientation": "auto"}},
    {"type": "gauge", "title": "Processors in use", "gridPos": {"x": 18, "y": 1, "w": 3, "h": 4}, "description": "Share of the machine's processors that are working, over the last minute.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "100 * sum(rate(eforecast_machine_cpu_seconds_total{mode!=\"idle\"}[1m])) / scalar(eforecast_machine_cpus)"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showThresholdMarkers": false}},
    {"type": "bargauge", "title": "Cards busy", "gridPos": {"x": 21, "y": 1, "w": 3, "h": 4}, "description": "Load of each card now. A card at 0 % while trials are left is a card nothing is using.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (gpu) (DCGM_FI_DEV_GPU_UTIL)", "legendFormat": "card {{gpu}}"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}, "overrides": []}, "options": {"displayMode": "basic", "orientation": "horizontal", "showUnfilled": true, "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}},
    {"type": "table", "title": "Trials training now", "gridPos": {"x": 0, "y": 5, "w": 24, "h": 6}, "description": "One line per trial that is training. epoch: the last one it finished, of how many it may run at most; epochs: that share as a bar (it may stop earlier). loop: how far the loop over batches it is in has got; pass says whether that loop trains or evaluates; it/s: its batches per second; loop left: the time it still needs. quiet for: how long since the trial last wrote to its log -- one that hangs stops writing. The same as bin/eforecast trials.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (case, cluster, method, trial, gpu) (eforecast_trial_epoch{case=~\"$case\"})", "format": "table", "instant": true}, {"refId": "B", "expr": "max by (case, cluster, method, trial, gpu) (eforecast_trial_epochs_total{case=~\"$case\"})", "format": "table", "instant": true}, {"refId": "C", "expr": "max by (case, cluster, method, trial, gpu) (100 * (eforecast_trial_epoch{case=~\"$case\"} + 1) / eforecast_trial_epochs_total)", "format": "table", "instant": true}, {"refId": "D", "expr": "max by (case, cluster, method, trial, gpu) (100 * eforecast_trial_loop_done{case=~\"$case\"} / eforecast_trial_loop_total)", "format": "table", "instant": true}, {"refId": "E", "expr": "max by (case, cluster, method, trial, gpu) (eforecast_trial_loop_training{case=~\"$case\"})", "format": "table", "instant": true}, {"refId": "F", "expr": "max by (case, cluster, method, trial, gpu) (eforecast_trial_loop_rate{case=~\"$case\"})", "format": "table", "instant": true}, {"refId": "G", "expr": "max by (case, cluster, method, trial, gpu) (eforecast_trial_loop_left_seconds{case=~\"$case\"})", "format": "table", "instant": true}, {"refId": "H", "expr": "max by (case, cluster, method, trial, gpu) (eforecast_trial_error{case=~\"$case\",set=\"val\"})", "format": "table", "instant": true}, {"refId": "I", "expr": "max by (case, cluster, method, trial, gpu) (eforecast_trial_error{case=~\"$case\",set=\"test\"})", "format": "table", "instant": true}, {"refId": "J", "expr": "max by (case, cluster, method, trial, gpu) (eforecast_trial_best_error{case=~\"$case\",set=\"val\"})", "format": "table", "instant": true}, {"refId": "K", "expr": "max by (case, cluster, method, trial, gpu) (1 / eforecast_trial_epochs_per_second{case=~\"$case\"})", "format": "table", "instant": true}, {"refId": "L", "expr": "max by (case, cluster, method, trial, gpu) (eforecast_trial_running_seconds{case=~\"$case\"})", "format": "table", "instant": true}, {"refId": "M", "expr": "max by (case, cluster, method, trial, gpu) (eforecast_trial_log_age_seconds{case=~\"$case\"})", "format": "table", "instant": true}, {"refId": "N", "expr": "max by (case, cluster, method, trial, gpu) (rate(eforecast_trial_cpu_seconds_total{case=~\"$case\"}[1m]))", "format": "table", "instant": true}, {"refId": "O", "expr": "max by (case, cluster, method, trial, gpu) (eforecast_trial_memory_bytes{case=~\"$case\"})", "format": "table", "instant": true}, {"refId": "P", "expr": "max by (case, cluster, method, trial, gpu) (eforecast_trial_gpu_memory_bytes{case=~\"$case\"})", "format": "table", "instant": true}], "transformations": [{"id": "merge", "options": {}}, {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"Value #A": "epoch", "Value #B": "of", "Value #C": "epochs", "Value #D": "loop", "Value #E": "pass", "Value #F": "it/s", "Value #G": "loop left", "Value #H": "val", "Value #I": "test", "Value #J": "best val", "Value #K": "s/epoch", "Value #L": "running", "Value #M": "quiet for", "Value #N": "CPUs", "Value #O": "memory", "Value #P": "on card", "gpu": "card"}, "indexByName": {"case": 0, "cluster": 1, "method": 2, "trial": 3, "gpu": 4, "Value #A": 5, "Value #B": 6, "Value #C": 7, "Value #D": 8, "Value #E": 9, "Value #F": 10, "Value #G": 11, "Value #H": 12, "Value #I": 13, "Value #J": 14, "Value #K": 15, "Value #L": 16, "Value #M": 17, "Value #N": 18, "Value #O": 19, "Value #P": 20}}}], "fieldConfig": {"defaults": {"custom": {"align": "auto", "filterable": true, "minWidth": 50, "cellOptions": {"type": "auto"}}}, "overrides": [{"matcher": {"id": "byName", "options": "epochs"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "min", "value": 0}, {"id": "max", "value": 100}, {"id": "decimals", "value": 0}, {"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "basic", "valueDisplayMode": "text"}}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "purple"}}]}, {"matcher": {"id": "byName", "options": "loop"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "min", "value": 0}, {"id": "max", "value": 100}, {"id": "decimals", "value": 0}, {"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "basic", "valueDisplayMode": "text"}}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]}, {"matcher": {"id": "byName", "options": "pass"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"1": {"text": "training", "color": "blue", "index": 0}, "0": {"text": "evaluating", "color": "yellow", "index": 1}}}]}, {"id": "custom.cellOptions", "value": {"type": "color-text"}}]}, {"matcher": {"id": "byName", "options": "it/s"}, "properties": [{"id": "unit", "value": "none"}, {"id": "decimals", "value": 2}]}, {"matcher": {"id": "byName", "options": "loop left"}, "properties": [{"id": "unit", "value": "s"}, {"id": "decimals", "value": 0}]}, {"matcher": {"id": "byName", "options": "val"}, "properties": [{"id": "decimals", "value": 4}]}, {"matcher": {"id": "byName", "options": "test"}, "properties": [{"id": "decimals", "value": 4}]}, {"matcher": {"id": "byName", "options": "best val"}, "properties": [{"id": "decimals", "value": 4}]}, {"matcher": {"id": "byName", "options": "s/epoch"}, "properties": [{"id": "unit", "value": "s"}, {"id": "decimals", "value": 0}]}, {"matcher": {"id": "byName", "options": "running"}, "properties": [{"id": "unit", "value": "s"}, {"id": "decimals", "value": 1}]}, {"matcher": {"id": "byName", "options": "quiet for"}, "properties": [{"id": "unit", "value": "s"}, {"id": "decimals", "value": 0}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "text", "value": null}, {"color": "orange", "value": 300}, {"color": "red", "value": 1800}]}}, {"id": "custom.cellOptions", "value": {"type": "color-text"}}]}, {"matcher": {"id": "byName", "options": "CPUs"}, "properties": [{"id": "decimals", "value": 2}]}, {"matcher": {"id": "byName", "options": "memory"}, "properties": [{"id": "unit", "value": "bytes"}, {"id": "decimals", "value": 1}]}, {"matcher": {"id": "byName", "options": "on card"}, "properties": [{"id": "unit", "value": "bytes"}, {"id": "decimals", "value": 1}]}, {"matcher": {"id": "byName", "options": "epoch"}, "properties": [{"id": "decimals", "value": 0}]}, {"matcher": {"id": "byName", "options": "of"}, "properties": [{"id": "decimals", "value": 0}]}]}, "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}, "sortBy": [{"displayName": "running", "desc": true}]}},
    {"type": "row", "title": "Inside the epochs", "gridPos": {"x": 0, "y": 11, "w": 24, "h": 1}, "collapsed": false},
    {"type": "timeseries", "title": "Error after each epoch", "gridPos": {"x": 0, "y": 12, "w": 8, "h": 9}, "description": "The error of the epoch each trial has just finished: on the validation set (solid) and on the test set (dashed). A trial's lines end when the trial does.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (case, cluster, method, trial) (eforecast_trial_error{case=~\"$case\",set=\"val\"})", "legendFormat": "{{cluster}} {{method}} {{trial}} val"}, {"refId": "B", "expr": "max by (case, cluster, method, trial) (eforecast_trial_error{case=~\"$case\",set=\"test\"})", "legendFormat": "{{cluster}} {{method}} {{trial}} test"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}, "decimals": 4}, "overrides": [{"matcher": {"id": "byRegexp", "options": ".* test$"}, "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [6, 4]}}]}]}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Speed of the loop (batches per second)", "gridPos": {"x": 8, "y": 12, "w": 8, "h": 9}, "description": "it/s as the progress bar of each trial says it now, and of its last whole training pass. A loop that evaluates runs at another speed than one that trains, so the line steps between the two.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (case, cluster, method, trial) (eforecast_trial_loop_rate{case=~\"$case\"})", "legendFormat": "{{cluster}} {{method}} {{trial}} now"}, {"refId": "B", "expr": "max by (case, cluster, method, trial) (eforecast_trial_loops_per_second{case=~\"$case\"})", "legendFormat": "{{cluster}} {{method}} {{trial}} last training pass"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}, "decimals": 2}, "overrides": [{"matcher": {"id": "byRegexp", "options": ".* last training pass$"}, "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [6, 4]}}]}]}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Where each trial is", "gridPos": {"x": 16, "y": 12, "w": 8, "h": 9}, "description": "The loop over batches fills from 0 to 100 % again and again, a tooth per pass; the epochs climb a step per epoch towards 100 % of what the trial may run. A flat line is a trial that is not moving.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (case, cluster, method, trial) (100 * eforecast_trial_loop_done{case=~\"$case\"} / eforecast_trial_loop_total)", "legendFormat": "{{cluster}} {{method}} {{trial}} loop"}, {"refId": "B", "expr": "max by (case, cluster, method, trial) (100 * (eforecast_trial_epoch{case=~\"$case\"} + 1) / eforecast_trial_epochs_total)", "legendFormat": "{{cluster}} {{method}} {{trial}} epochs"}], "fieldConfig": {"defaults": {"unit": "percent", "custom": {"lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}, "min": 0, "max": 100}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "row", "title": "Studies: what is done and what is left", "gridPos": {"x": 0, "y": 21, "w": 24, "h": 1}, "collapsed": false},
    {"type": "timeseries", "title": "Trials left", "gridPos": {"x": 0, "y": 22, "w": 8, "h": 8}, "description": "The trials every study of a case will still be given, added up. It goes down a step with every trial that completes or is pruned; its slope is how fast the training is getting done.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (case) (eforecast_study_trials_left{case=~\"$case\"})", "legendFormat": "{{case}}"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Trials finished in the last hour", "gridPos": {"x": 8, "y": 22, "w": 8, "h": 8}, "description": "How many trials ended in the hour before each moment: completed or pruned, and failed.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (case) (delta(eforecast_study_trials{case=~\"$case\",state=~\"complete|pruned\"}[1h]))", "legendFormat": "{{case}} finished"}, {"refId": "B", "expr": "sum by (case) (delta(eforecast_study_trials{case=~\"$case\",state=\"failed\"}[1h]))", "legendFormat": "{{case}} failed"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 1, "fillOpacity": 60, "showPoints": "never", "spanNulls": false, "drawStyle": "bars", "stacking": {"mode": "none"}}, "min": 0}, "overrides": [{"matcher": {"id": "byRegexp", "options": ".* failed$"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}]}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "bargauge", "title": "Trials, by how they stand", "gridPos": {"x": 16, "y": 22, "w": 8, "h": 8}, "description": "Every trial of the selected cases: complete, pruned, failed, running, waiting -- the trials still to come (left) -- and the trials their studies lack and will not be asked for, because the study has used up its attempts (will not run).", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (state) (eforecast_study_trials{case=~\"$case\"})", "legendFormat": "{{state}}"}, {"refId": "B", "expr": "sum(eforecast_study_trials_left{case=~\"$case\"})", "legendFormat": "left"}, {"refId": "C", "expr": "sum(eforecast_study_trials_given_up{case=~\"$case\"})", "legendFormat": "will not run"}], "fieldConfig": {"defaults": {"unit": "none", "min": 0, "mappings": [], "color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": [{"matcher": {"id": "byName", "options": "complete"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]}, {"matcher": {"id": "byName", "options": "pruned"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]}, {"matcher": {"id": "byName", "options": "failed"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}, {"matcher": {"id": "byName", "options": "running"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]}, {"matcher": {"id": "byName", "options": "waiting"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "text"}}]}, {"matcher": {"id": "byName", "options": "left"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "purple"}}]}, {"matcher": {"id": "byName", "options": "will not run"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]}]}, "options": {"displayMode": "basic", "orientation": "horizontal", "showUnfilled": true, "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}},
    {"type": "table", "title": "Every study", "gridPos": {"x": 0, "y": 30, "w": 24, "h": 11}, "description": "One line per study: a method in a cluster of a case. left = the trials it will still be given: the ones running and the ones still to be asked for. A study is asked for at most twice the trials wanted of it (a trial stopped with its run, or whose card was lost, does not count), so one whose trials keep failing ends short: will not run = what it lacks beyond its attempts. Click a column to sort, or filter it; the studies with the most left are first. The same as bin/eforecast studies.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (case, cluster, method) (eforecast_study_trials{case=~\"$case\",state=\"complete\"})", "format": "table", "instant": true}, {"refId": "B", "expr": "max by (case, cluster, method) (eforecast_study_trials{case=~\"$case\",state=\"pruned\"})", "format": "table", "instant": true}, {"refId": "C", "expr": "max by (case, cluster, method) (eforecast_study_trials{case=~\"$case\",state=\"failed\"})", "format": "table", "instant": true}, {"refId": "D", "expr": "max by (case, cluster, method) (eforecast_study_trials{case=~\"$case\",state=\"running\"})", "format": "table", "instant": true}, {"refId": "E", "expr": "max by (case, cluster, method) (eforecast_study_trials_left{case=~\"$case\"})", "format": "table", "instant": true}, {"refId": "F", "expr": "max by (case, cluster, method) (eforecast_study_trials_wanted{case=~\"$case\"})", "format": "table", "instant": true}, {"refId": "G", "expr": "100 * sum by (case, cluster, method) (eforecast_study_trials{case=~\"$case\",state=~\"complete|pruned\"}) / on (case, cluster, method) max by (case, cluster, method) (eforecast_study_trials_wanted{case=~\"$case\"})", "format": "table", "instant": true}, {"refId": "H", "expr": "max by (case, cluster, method) (eforecast_study_best_value{case=~\"$case\"})", "format": "table", "instant": true}, {"refId": "I", "expr": "max by (case, cluster, method) (eforecast_study_trial_seconds{case=~\"$case\"})", "format": "table", "instant": true}, {"refId": "J", "expr": "max by (case, cluster, method) (eforecast_study_last_finished_timestamp_seconds{case=~\"$case\"} * 1000)", "format": "table", "instant": true}, {"refId": "K", "expr": "max by (case, cluster, method) (eforecast_study_trials_left{case=~\"$case\"} * eforecast_study_trial_seconds)", "format": "table", "instant": true}, {"refId": "L", "expr": "max by (case, cluster, method) (eforecast_study_trials_given_up{case=~\"$case\"})", "format": "table", "instant": true}], "transformations": [{"id": "merge", "options": {}}, {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"Value #A": "complete", "Value #B": "pruned", "Value #C": "failed", "Value #D": "running", "Value #E": "left", "Value #F": "wanted", "Value #G": "done", "Value #H": "best value", "Value #I": "a trial takes", "Value #J": "last finished", "Value #K": "training left", "Value #L": "will not run"}, "indexByName": {"case": 0, "cluster": 1, "method": 2, "Value #A": 3, "Value #B": 4, "Value #C": 5, "Value #D": 6, "Value #E": 7, "Value #L": 8, "Value #F": 9, "Value #G": 10, "Value #H": 11, "Value #I": 12, "Value #J": 13, "Value #K": 14}}}], "fieldConfig": {"defaults": {"custom": {"align": "auto", "filterable": true, "minWidth": 50, "cellOptions": {"type": "auto"}}}, "overrides": [{"matcher": {"id": "byName", "options": "done"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "min", "value": 0}, {"id": "max", "value": 100}, {"id": "decimals", "value": 0}, {"id": "custom.cellOptions", "value": {"type": "gauge", "mode": "basic", "valueDisplayMode": "text"}}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]}, {"matcher": {"id": "byName", "options": "best value"}, "properties": [{"id": "decimals", "value": 4}]}, {"matcher": {"id": "byName", "options": "a trial takes"}, "properties": [{"id": "unit", "value": "s"}, {"id": "decimals", "value": 0}]}, {"matcher": {"id": "byName", "options": "last finished"}, "properties": [{"id": "unit", "value": "dateTimeFromNow"}]}, {"matcher": {"id": "byName", "options": "training left"}, "properties": [{"id": "unit", "value": "s"}, {"id": "decimals", "value": 1}]}, {"matcher": {"id": "byName", "options": "failed"}, "properties": [{"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "text", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}}, {"id": "custom.cellOptions", "value": {"type": "color-text"}}]}, {"matcher": {"id": "byName", "options": "running"}, "properties": [{"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "text", "value": null}, {"color": "blue", "value": 1}]}}, {"id": "custom.cellOptions", "value": {"type": "color-text"}}]}, {"matcher": {"id": "byName", "options": "will not run"}, "properties": [{"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "text", "value": null}, {"color": "orange", "value": 1}]}}, {"id": "custom.cellOptions", "value": {"type": "color-text"}}]}]}, "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}, "sortBy": [{"displayName": "left", "desc": true}]}},
    {"type": "row", "title": "What has finished", "gridPos": {"x": 0, "y": 41, "w": 24, "h": 1}, "collapsed": false},
    {"type": "table", "title": "Trials that finished last", "gridPos": {"x": 0, "y": 42, "w": 10, "h": 10}, "description": "The forty trials that ended most recently, the newest first: complete, pruned or failed, with the value the study minimises (a pruned trial: its value when it was stopped) and how long it ran.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (case, cluster, method, trial, state) (eforecast_finished_trial_timestamp_seconds{case=~\"$case\"}) * 1000", "format": "table", "instant": true}, {"refId": "B", "expr": "max by (case, cluster, method, trial, state) (eforecast_finished_trial_value{case=~\"$case\"})", "format": "table", "instant": true}, {"refId": "C", "expr": "max by (case, cluster, method, trial, state) (eforecast_finished_trial_seconds{case=~\"$case\"})", "format": "table", "instant": true}], "transformations": [{"id": "merge", "options": {}}, {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"Value #A": "finished", "Value #B": "value", "Value #C": "took", "state": "ended"}, "indexByName": {"Value #A": 0, "case": 1, "cluster": 2, "method": 3, "trial": 4, "state": 5, "Value #B": 6, "Value #C": 7}}}], "fieldConfig": {"defaults": {"custom": {"align": "auto", "filterable": true, "minWidth": 50, "cellOptions": {"type": "auto"}}}, "overrides": [{"matcher": {"id": "byName", "options": "finished"}, "properties": [{"id": "unit", "value": "dateTimeFromNow"}]}, {"matcher": {"id": "byName", "options": "value"}, "properties": [{"id": "decimals", "value": 4}, {"id": "mappings", "value": [{"type": "special", "options": {"match": "nan", "result": {"text": "", "index": 0}}}]}]}, {"matcher": {"id": "byName", "options": "took"}, "properties": [{"id": "unit", "value": "s"}, {"id": "decimals", "value": 0}]}, {"matcher": {"id": "byName", "options": "ended"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"complete": {"text": "complete", "color": "green", "index": 0}, "pruned": {"text": "pruned", "color": "yellow", "index": 1}, "failed": {"text": "failed", "color": "red", "index": 2}, "running": {"text": "running", "color": "blue", "index": 3}, "waiting": {"text": "waiting", "color": "text", "index": 4}, "left": {"text": "left", "color": "purple", "index": 5}, "will not run": {"text": "will not run", "color": "orange", "index": 6}}}]}, {"id": "custom.cellOptions", "value": {"type": "color-text"}}]}]}, "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}, "sortBy": [{"displayName": "finished", "desc": true}]}},
    {"type": "table", "title": "Finished trials with their hyper-parameters (from the Optuna dashboard's database)", "gridPos": {"x": 10, "y": 42, "w": 14, "h": 10}, "description": "The three hundred trials that ended last, with the parameters each was trained with. It reads the database the Optuna dashboard reads, which the service optuna-mirror fills from the studies of the cases; empty while that service is not running. finished is the time of the training machine. The database holds one study for a case and a cluster; method and trial are what each trial says of itself there.", "datasource": {"type": "postgres", "uid": "optuna"}, "targets": [{"refId": "A", "format": "table", "rawQuery": true, "rawSql": "SELECT a.value_json::json->>'case' AS \"case\", a.value_json::json->>'cluster' AS cluster,\n       m.value_json::json#>>'{}' AS method, f.value_json::json#>>'{}' AS trial, lower(t.state::text) AS ended,\n       v.value AS value, extract(epoch FROM (t.datetime_complete - t.datetime_start)) AS took,\n       to_char(t.datetime_complete, 'DD Mon HH24:MI') AS finished,\n       (SELECT string_agg(substr(p.param_name, length(m.value_json::json#>>'{}') + 2) || '=' ||\n               CASE WHEN p.distribution_json::json->>'name' = 'CategoricalDistribution'\n                    THEN p.distribution_json::json->'attributes'->'choices'->>(p.param_value::int)\n                    WHEN p.param_value = round(p.param_value) THEN round(p.param_value)::bigint::text\n                    ELSE to_char(p.param_value, 'FM999999990.999999') END, ', ' ORDER BY p.param_name)\n          FROM trial_params p WHERE p.trial_id = t.trial_id AND p.param_name <> '(method)') AS parameters\n  FROM trials t\n  JOIN study_user_attributes a ON a.study_id = t.study_id AND a.key = 'eforecast_mirror'\n  JOIN trial_user_attributes m ON m.trial_id = t.trial_id AND m.key = 'method'\n  JOIN trial_user_attributes f ON f.trial_id = t.trial_id AND f.key = 'folder'\n  LEFT JOIN trial_values v ON v.trial_id = t.trial_id AND v.objective = 0\n WHERE a.value_json::json->>'case' ~ '^(${case:regex})$' AND t.state::text IN ('COMPLETE', 'PRUNED', 'FAIL')\n ORDER BY t.datetime_complete DESC NULLS LAST\n LIMIT 300"}], "fieldConfig": {"defaults": {"custom": {"align": "auto", "filterable": true, "minWidth": 50, "cellOptions": {"type": "auto"}}}, "overrides": [{"matcher": {"id": "byName", "options": "ended"}, "properties": [{"id": "custom.width", "value": 80}, {"id": "mappings", "value": [{"type": "value", "options": {"complete": {"text": "complete", "color": "green", "index": 0}, "pruned": {"text": "pruned", "color": "yellow", "index": 1}, "fail": {"text": "failed", "color": "red", "index": 2}}}]}, {"id": "custom.cellOptions", "value": {"type": "color-text"}}]}, {"matcher": {"id": "byName", "options": "case"}, "properties": [{"id": "custom.width", "value": 95}]}, {"matcher": {"id": "byName", "options": "cluster"}, "properties": [{"id": "custom.width", "value": 95}]}, {"matcher": {"id": "byName", "options": "method"}, "properties": [{"id": "custom.width", "value": 70}]}, {"matcher": {"id": "byName", "options": "trial"}, "properties": [{"id": "custom.width", "value": 70}]}, {"matcher": {"id": "byName", "options": "value"}, "properties": [{"id": "custom.width", "value": 70}, {"id": "decimals", "value": 4}]}, {"matcher": {"id": "byName", "options": "took"}, "properties": [{"id": "custom.width", "value": 75}, {"id": "unit", "value": "s"}, {"id": "decimals", "value": 0}]}, {"matcher": {"id": "byName", "options": "finished"}, "properties": [{"id": "custom.width", "value": 105}]}, {"matcher": {"id": "byName", "options": "parameters"}, "properties": [{"id": "custom.minWidth", "value": 380}]}]}, "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}}},
    {"type": "bargauge", "title": "Why trials of this run failed", "gridPos": {"x": 0, "y": 52, "w": 8, "h": 8}, "description": "From the orchestrator of the training itself (port 9108), so for the run that is going on and only for a training started from code of 20 November 2026 or later; an older one leaves this empty and says it in its log. oom: it ran out of card memory, also alone on a card and, where that is allowed, with half its batch. card_lost: the driver lost the card under it; such a trial is not counted as an attempt of its study. preparation: its data could not be prepared. unschedulable: the run had no card for it (in a training from before 24 November 2026 also a trial refused on an estimate of its size, without a try). error: anything else; the trial's train.log and error.txt say what.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (reason) (eforecast_trials_failed_by_reason_total) > 0", "legendFormat": "{{reason}}"}], "fieldConfig": {"defaults": {"unit": "none", "min": 0, "color": {"mode": "fixed", "fixedColor": "red"}}, "overrides": []}, "options": {"displayMode": "basic", "orientation": "horizontal", "showUnfilled": true, "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}},
    {"type": "table", "title": "Failed trials of this run, one by one", "gridPos": {"x": 8, "y": 52, "w": 16, "h": 8}, "description": "From the orchestrator of the training itself (port 9108), so for the run that is going on and only for a training started from code of 20 November 2026 or later; an older one leaves this empty and says it in its log. The newest twenty, each with its study and the reason.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (unit, trial, reason) (eforecast_trial_failed_info)", "format": "table", "instant": true}], "transformations": [{"id": "merge", "options": {}}, {"id": "organize", "options": {"excludeByName": {"Time": true, "Value": true}, "renameByName": {"unit": "study"}, "indexByName": {"unit": 0, "trial": 1, "reason": 2}}}], "fieldConfig": {"defaults": {"custom": {"align": "auto", "filterable": true, "minWidth": 50, "cellOptions": {"type": "auto"}}}, "overrides": [{"matcher": {"id": "byName", "options": "reason"}, "properties": [{"id": "custom.cellOptions", "value": {"type": "color-text"}}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}]}, "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}}},
    {"type": "row", "title": "The machine", "gridPos": {"x": 0, "y": 60, "w": 24, "h": 1}, "collapsed": false},
    {"type": "timeseries", "title": "Processors in use, by what", "gridPos": {"x": 0, "y": 61, "w": 8, "h": 8}, "description": "How many processors each kind of pipeline process keeps busy, and the machine as a whole (which includes everything else). The machine has as many as the dashed line.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (role) (rate(eforecast_process_cpu_seconds_total{role!=\"other\"}[1m]))", "legendFormat": "{{role}}"}, {"refId": "B", "expr": "sum(rate(eforecast_machine_cpu_seconds_total{mode!=\"idle\"}[1m]))", "legendFormat": "the whole machine"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}, "decimals": 1}, "overrides": [{"matcher": {"id": "byName", "options": "the whole machine"}, "properties": [{"id": "custom.lineWidth", "value": 2}, {"id": "custom.fillOpacity", "value": 0}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "text"}}]}]}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Cards: load and memory", "gridPos": {"x": 8, "y": 61, "w": 8, "h": 8}, "description": "Each card's load and how full its memory is.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (gpu) (DCGM_FI_DEV_GPU_UTIL)", "legendFormat": "card {{gpu}} load %"}, {"refId": "B", "expr": "max by (gpu) (100 * DCGM_FI_DEV_FB_USED / (DCGM_FI_DEV_FB_USED + DCGM_FI_DEV_FB_FREE))", "legendFormat": "card {{gpu}} memory %"}], "fieldConfig": {"defaults": {"unit": "percent", "custom": {"lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}, "min": 0, "max": 100}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "timeseries", "title": "Cards: temperature, and slowing down for heat", "gridPos": {"x": 16, "y": 61, "w": 8, "h": 8}, "description": "A card that slows itself down for heat while its temperature looks ordinary has something else running hot. That is what card 0 did before it was lost in November 2026. Power is on the dashboard eforecast processes.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (gpu) (DCGM_FI_DEV_GPU_TEMP)", "legendFormat": "card {{gpu}} °C"}, {"refId": "B", "expr": "100 * max by (gpu) (rate(eforecast_gpu_thermal_slowdown_seconds_total[2m]))", "legendFormat": "card {{gpu}} slowed for heat, % of the time"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 1, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "drawStyle": "line", "stacking": {"mode": "none"}}, "min": 0, "max": 100}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"], "sortBy": "Last *", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"type": "table", "title": "Processes now", "gridPos": {"x": 0, "y": 69, "w": 24, "h": 10}, "description": "Every process of the pipeline -- a training, its trials and their data loaders, a combination, the pages, the services, the daemons that share a card -- and, as role other, the heaviest other processes of the machine. CPUs: processors in use over the last minute. More on the dashboard eforecast processes.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max by (role, case, cluster, method, trial, name, pid) (rate(eforecast_process_cpu_seconds_total[1m]))", "format": "table", "instant": true}, {"refId": "B", "expr": "max by (role, case, cluster, method, trial, name, pid) (eforecast_process_memory_bytes)", "format": "table", "instant": true}, {"refId": "C", "expr": "max by (role, case, cluster, method, trial, name, pid) (eforecast_process_gpu_memory_bytes)", "format": "table", "instant": true}, {"refId": "D", "expr": "max by (role, case, cluster, method, trial, name, pid) (eforecast_process_threads)", "format": "table", "instant": true}, {"refId": "E", "expr": "max by (role, case, cluster, method, trial, name, pid) (eforecast_process_start_time_seconds) * 1000", "format": "table", "instant": true}], "transformations": [{"id": "merge", "options": {}}, {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"Value #A": "CPUs", "Value #B": "memory", "Value #C": "on card", "Value #D": "threads", "Value #E": "started", "name": "what"}, "indexByName": {"role": 0, "case": 1, "cluster": 2, "method": 3, "trial": 4, "name": 5, "pid": 6, "Value #A": 7, "Value #B": 8, "Value #C": 9, "Value #D": 10, "Value #E": 11}}}], "fieldConfig": {"defaults": {"custom": {"align": "auto", "filterable": true, "minWidth": 50, "cellOptions": {"type": "auto"}}}, "overrides": [{"matcher": {"id": "byName", "options": "CPUs"}, "properties": [{"id": "decimals", "value": 2}]}, {"matcher": {"id": "byName", "options": "memory"}, "properties": [{"id": "unit", "value": "bytes"}, {"id": "decimals", "value": 1}]}, {"matcher": {"id": "byName", "options": "on card"}, "properties": [{"id": "unit", "value": "bytes"}, {"id": "decimals", "value": 1}]}, {"matcher": {"id": "byName", "options": "started"}, "properties": [{"id": "unit", "value": "dateTimeFromNow"}]}, {"matcher": {"id": "byName", "options": "threads"}, "properties": [{"id": "decimals", "value": 0}]}]}, "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}, "sortBy": [{"displayName": "CPUs", "desc": true}]}}
  ]
}
