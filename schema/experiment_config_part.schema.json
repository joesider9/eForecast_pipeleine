                {
                  "type": "integer"
                }
              ],
              "gt": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rated Power"
        },
        "type": {
          "$ref": "#/$defs/ProblemType"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
