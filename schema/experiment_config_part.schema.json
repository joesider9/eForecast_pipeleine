        "name": {
          "title": "Name",
          "type": "string"
        },
        "group": {
          "title": "Group",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "version_model": {
          "minimum": 0,
          "title": "Version Model",
          "type": "integer"
        },
        "version_group": {
          "minimum": 0,
          "title": "Version Group",
          "type": "integer"
        },
        "horizon_type": {
          "$ref": "#/$defs/HorizonType"
        },
        "horizon": {
          "title": "Horizon",
          "type": "integer"
        },
        "coordinates": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
